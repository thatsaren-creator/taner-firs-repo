```html
<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Tahir Dastan Hair Design | Konak İzmir</title>

  <meta name="description" content="Tahir Dastan Hair Design — İzmir Konak'ta profesyonel saç tasarımı ve kuaför hizmetleri. WhatsApp üzerinden hızlıca randevu alın.">
  <meta name="keywords" content="Tahir Dastan Hair Design, İzmir kuaför, Konak kuaför, saç tasarımı, kadın kuaförü, saç kesimi">
  <meta name="author" content="Tahir Dastan Hair Design">

  <meta property="og:title" content="Tahir Dastan Hair Design">
  <meta property="og:description" content="Profesyonel saç tasarımı ve kişisel stil dokunuşları.">
  <meta property="og:type" content="website">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg: #11100f;
      --bg-soft: #191716;
      --card: #211e1c;
      --cream: #f3eee7;
      --muted: #aaa29a;
      --gold: #c6a36a;
      --gold-light: #e2c795;
      --border: rgba(255,255,255,.09);
      --white: #fff;
      --whatsapp: #25D366;
      --max: 1180px;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--bg);
      color: var(--cream);
      font-family: "DM Sans", sans-serif;
      line-height: 1.6;
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(var(--max), calc(100% - 40px));
      margin: auto;
    }

    /* NAVBAR */

    header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      transition: .3s ease;
    }

    header.scrolled {
      background: rgba(17,16,15,.94);
      backdrop-filter: blur(18px);
      border-bottom: 1px solid var(--border);
    }

    .nav {
      height: 82px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .logo {
      font-family: "Playfair Display", serif;
      font-size: 21px;
      letter-spacing: .5px;
    }

    .logo span {
      display: block;
      font-family: "DM Sans", sans-serif;
      font-size: 9px;
      letter-spacing: 3px;
      color: var(--gold);
      margin-top: -3px;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      gap: 30px;
      align-items: center;
      list-style: none;
    }

    .nav-links a {
      color: #d7d0c9;
      font-size: 13px;
      transition: .25s;
    }

    .nav-links a:hover {
      color: var(--gold-light);
    }

    .nav-cta {
      background: var(--cream);
      color: #151311;
      padding: 12px 19px;
      border-radius: 2px;
      font-size: 12px;
      font-weight: 700;
      transition: .25s;
    }

    .nav-cta:hover {
      background: var(--gold-light);
      transform: translateY(-2px);
    }

    .menu-btn {
      display: none;
      border: 0;
      background: transparent;
      color: white;
      font-size: 25px;
      cursor: pointer;
    }

    /* HERO */

    .hero {
      min-height: 100vh;
      position: relative;
      display: flex;
      align-items: center;
      background:
        linear-gradient(90deg, rgba(8,7,6,.88) 0%, rgba(8,7,6,.62) 45%, rgba(8,7,6,.35) 100%),
        linear-gradient(0deg, rgba(8,7,6,.55), transparent 45%),
        url("hero.jpg") center/cover no-repeat;
    }

    .hero-content {
      padding-top: 80px;
      max-width: 720px;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--gold-light);
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .eyebrow::before {
      content: "";
      width: 32px;
      height: 1px;
      background: var(--gold);
    }

    .hero h1 {
      font-family: "Playfair Display", serif;
      font-size: clamp(54px, 7vw, 94px);
      line-height: .98;
      font-weight: 600;
      letter-spacing: -3px;
      margin-bottom: 25px;
    }

    .hero h1 em {
      color: var(--gold-light);
      font-style: normal;
    }

    .hero-text {
      color: #d1cbc5;
      font-size: 17px;
      max-width: 520px;
      margin-bottom: 32px;
    }

    .hero-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
    }

    .btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 9px;
      min-height: 52px;
      padding: 0 23px;
      font-size: 13px;
      font-weight: 700;
      border-radius: 2px;
      transition: .25s ease;
    }

    .btn-primary {
      background: var(--cream);
      color: #151311;
    }

    .btn-primary:hover {
      background: var(--gold-light);
      transform: translateY(-2px);
    }

    .btn-outline {
      border: 1px solid rgba(255,255,255,.35);
      color: white;
    }

    .btn-outline:hover {
      border-color: var(--gold);
      color: var(--gold-light);
    }

    .rating {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 32px;
      font-size: 13px;
      color: #c9c2bb;
    }

    .stars {
      color: var(--gold-light);
      letter-spacing: 2px;
    }

    /* SECTION */

    section {
      padding: 110px 0;
    }

    .section-head {
      margin-bottom: 50px;
      max-width: 650px;
    }

    .kicker {
      color: var(--gold);
      font-size: 10px;
      letter-spacing: 3px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }

    h2 {
      font-family: "Playfair Display", serif;
      font-size: clamp(38px, 5vw, 58px);
      line-height: 1.05;
      font-weight: 600;
    }

    .section-sub {
      color: var(--muted);
      margin-top: 17px;
      font-size: 15px;
    }

    /* SERVICES */

    .services {
      background: var(--bg-soft);
    }

    .service-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 15px;
    }

    .service {
      position: relative;
      min-height: 230px;
      padding: 30px;
      background: var(--card);
      border: 1px solid var(--border);
      transition: .3s;
      overflow: hidden;
    }

    .service::after {
      content: "";
      position: absolute;
      right: -50px;
      bottom: -70px;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      background: rgba(198,163,106,.06);
    }

    .service:hover {
      transform: translateY(-5px);
      border-color: rgba(198,163,106,.35);
    }

    .service-number {
      color: var(--gold);
      font-size: 11px;
      letter-spacing: 2px;
      margin-bottom: 40px;
    }

    .service h3 {
      font-family: "Playfair Display", serif;
      font-size: 26px;
      margin-bottom: 10px;
    }

    .service p {
      color: var(--muted);
      font-size: 13px;
    }

    /* ABOUT */

    .about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }

    .about-image {
      min-height: 550px;
      background:
        linear-gradient(rgba(0,0,0,.1), rgba(0,0,0,.3)),
        url("hero.jpg") center/cover;
    }

    .about-copy p {
      color: var(--muted);
      margin: 22px 0;
      font-size: 15px;
    }

    .features {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
      margin-top: 35px;
    }

    .feature {
      border-top: 1px solid var(--border);
      padding-top: 17px;
    }

    .feature strong {
      display: block;
      margin-bottom: 5px;
      font-size: 14px;
    }

    .feature span {
      color: var(--muted);
      font-size: 12px;
    }

    /* REVIEWS */

    .reviews {
      background: var(--bg-soft);
    }

    .review-box {
      border: 1px solid var(--border);
      padding: 50px;
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 70px;
      align-items: center;
      background: linear-gradient(135deg, #211e1c, #171514);
    }

    .score {
      font-family: "Playfair Display", serif;
      font-size: 75px;
      line-height: 1;
      color: var(--gold-light);
    }

    .score-small {
      color: var(--muted);
      font-size: 13px;
      margin-top: 10px;
    }

    .review-copy h3 {
      font-family: "Playfair Display", serif;
      font-size: 30px;
      margin-bottom: 12px;
    }

    .review-copy p {
      color: var(--muted);
      margin-bottom: 22px;
    }

    /* CTA */

    .appointment {
      text-align: center;
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at center, rgba(198,163,106,.12), transparent 45%),
        var(--bg);
    }

    .appointment h2 {
      max-width: 700px;
      margin: auto;
    }

    .appointment p {
      color: var(--muted);
      margin: 18px auto 28px;
      max-width: 500px;
    }

    /* LOCATION */

    .location-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .location-card {
      padding: 40px;
      background: var(--card);
      border: 1px solid var(--border);
    }

    .location-card h3 {
      font-family: "Playfair Display", serif;
      font-size: 28px;
      margin-bottom: 18px;
    }

    .address {
      color: var(--muted);
      margin-bottom: 28px;
    }

    .hours {
      list-style: none;
      margin-top: 25px;
    }

    .hours li {
      display: flex;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
      padding: 10px 0;
      color: #cfc8c1;
      font-size: 13px;
    }

    .hours li.closed {
      color: #8d8580;
    }

    .map {
      min-height: 430px;
      border: 1px solid var(--border);
      background:
        linear-gradient(rgba(0,0,0,.35), rgba(0,0,0,.55)),
        url("https://images.unsplash.com/photo-1524666041070-9f8767c6b4e3?auto=format&fit=crop&w=1200&q=80") center/cover;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* INSTAGRAM */

    .instagram {
      background: var(--bg-soft);
      text-align: center;
    }

    .instagram-inner {
      max-width: 700px;
      margin: auto;
    }

    .instagram-icon {
      width: 52px;
      height: 52px;
      border: 1px solid var(--gold);
      border-radius: 50%;
      display: grid;
      place-items: center;
      margin: 0 auto 22px;
      color: var(--gold-light);
      font-size: 21px;
    }

    /* FOOTER */

    footer {
      padding: 45px 0 25px;
      border-top: 1px solid var(--border);
    }

    .footer-top {
      display: flex;
      justify-content: space-between;
      gap: 30px;
      padding-bottom: 35px;
    }

    .footer-brand p {
      color: var(--muted);
      font-size: 12px;
      margin-top: 8px;
    }

    .footer-links {
      display: flex;
      gap: 25px;
      font-size: 12px;
      color: var(--muted);
    }

    .footer-bottom {
      padding-top: 20px;
      border-top: 1px solid var(--border);
      color: #716b66;
      font-size: 11px;
      display: flex;
      justify-content: space-between;
    }

    /* FLOATING WHATSAPP */

    .whatsapp {
      position: fixed;
      right: 22px;
      bottom: 22px;
      z-index: 900;
      background: var(--whatsapp);
      color: white;
      padding: 13px 18px;
      border-radius: 40px;
      display: flex;
      align-items: center;
      gap: 9px;
      font-size: 12px;
      font-weight: 700;
      box-shadow: 0 10px 30px rgba(0,0,0,.35);
      transition: .25s;
    }

    .whatsapp:hover {
      transform: translateY(-3px);
    }

    .whatsapp-icon {
      font-size: 18px;
    }

    /* REVEAL */

    .reveal {
      opacity: 0;
      transform: translateY(25px);
      transition: .7s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: translateY(0);
    }

    /* MOBILE */

    @media (max-width: 850px) {

      .container {
        width: min(var(--max), calc(100% - 28px));
      }

      .nav {
        height: 70px;
      }

      .nav-links,
      .nav-cta {
        display: none;
      }

      .menu-btn {
        display: block;
      }

      .hero {
        min-height: 88vh;
        background:
          linear-gradient(90deg, rgba(8,7,6,.82), rgba(8,7,6,.48)),
          linear-gradient(0deg, rgba(8,7,6,.7), transparent),
          url("hero.jpg") center/cover no-repeat;
      }

      .hero h1 {
        font-size: clamp(48px, 15vw, 72px);
        letter-spacing: -2px;
      }

      .hero-text {
        font-size: 15px;
      }

      section {
        padding: 75px 0;
      }

      .service-grid {
        grid-template-columns: 1fr;
      }

      .about-grid,
      .location-grid {
        grid-template-columns: 1fr;
        gap: 30px;
      }

      .about-image {
        min-height: 400px;
        order: 2;
      }

      .review-box {
        grid-template-columns: 1fr;
        gap: 30px;
        padding: 32px;
      }

      .score {
        font-size: 62px;
      }

      .location-card {
        padding: 28px;
      }

      .map {
        min-height: 320px;
      }

      .footer-top {
        flex-direction: column;
      }

      .footer-links {
        flex-wrap: wrap;
      }

      .footer-bottom {
        flex-direction: column;
        gap: 7px;
      }

      .whatsapp {
        right: 14px;
        bottom: 14px;
        padding: 13px 17px;
      }
    }

    @media (max-width: 480px) {

      .hero-buttons {
        flex-direction: column;
        align-items: stretch;
      }

      .btn {
        width: 100%;
      }

      .features {
        grid-template-columns: 1fr;
      }

      .hero-content {
        padding-top: 60px;
      }
    }
  </style>
</head>

<body>

<header id="header">
  <div class="container nav">

    <a href="#anasayfa" class="logo">
      Tahir Dastan
      <span>Hair Design</span>
    </a>

    <ul class="nav-links">
      <li><a href="#anasayfa">Ana Sayfa</a></li>
      <li><a href="#hizmetler">Hizmetler</a></li>
      <li><a href="#hakkimizda">Hakkımızda</a></li>
      <li><a href="#yorumlar">Yorumlar</a></li>
      <li><a href="#iletisim">İletişim</a></li>
    </ul>

    <a class="nav-cta"
       href="https://wa.me/905301822270?text=Merhaba%2C%20Tahir%20Dastan%20Hair%20Design%27dan%20randevu%20almak%20istiyorum.%20Uygun%20g%C3%BCn%20ve%20saatleri%20%C3%B6%C4%9Frenebilir%20miyim%3F"
       target="_blank">
      Randevu Al
    </a>

    <button class="menu-btn" onclick="toggleMenu()">☰</button>

  </div>
</header>

<main>

  <!-- HERO -->

  <section class="hero" id="anasayfa">

    <div class="container">
      <div class="hero-content reveal">

        <div class="eyebrow">
          Hair Design Studio
        </div>

        <h1>
          Tarzını<br>
          <em>Baştan Tasarla.</em>
        </h1>

        <p class="hero-text">
          Profesyonel saç tasarımı, modern dokunuşlar
          ve kişisel stil anlayışı.
        </p>

        <div class="hero-buttons">

          <a class="btn btn-primary"
             href="https://wa.me/905301822270?text=Merhaba%2C%20Tahir%20Dastan%20Hair%20Design%27dan%20randevu%20almak%20istiyorum.%20Uygun%20g%C3%BCn%20ve%20saatleri%20%C3%B6%C4%9Frenebilir%20miyim%3F"
             target="_blank">
            WhatsApp'tan Randevu Al
          </a>

          <a class="btn btn-outline"
             href="https://maps.app.goo.gl/h6yJHbL4vkA2HwRU9"
             target="_blank">
            Yol Tarifi Al
          </a>

        </div>

        <div class="rating">
          <span class="stars">★★★★★</span>
          <span>4.6 Google Puanı</span>
        </div>

      </div>
    </div>

  </section>

  <!-- SERVICES -->

  <section class="services" id="hizmetler">

    <div class="container">

      <div class="section-head reveal">
        <div class="kicker">Hizmetler</div>

        <h2>
          Profesyonel Dokunuş,
          <br>Net Sonuç.
        </h2>

        <p class="section-sub">
          Kişisel stiline uygun, modern ve özenli saç tasarımı.
        </p>
      </div>

      <div class="service-grid">

        <article class="service reveal">
          <div class="service-number">01</div>
          <h3>Saç Kesimi</h3>
          <p>
            Yüz hatlarına ve kişisel stiline uygun modern kesimler.
          </p>
        </article>

        <article class="service reveal">
          <div class="service-number">02</div>
          <h3>Saç Tasarımı</h3>
          <p>
            Güncel trendleri kişisel tarzınla buluşturan saç tasarımları.
          </p>
        </article>

        <article class="service reveal">
          <div class="service-number">03</div>
          <h3>Sakal Tasarımı</h3>
          <p>
            Yüz şekline uygun, temiz ve dengeli sakal tasarımı.
          </p>
        </article>

        <article class="service reveal">
          <div class="service-number">04</div>
          <h3>Saç & Sakal</h3>
          <p>
            Saç ve sakalın birlikte değerlendirildiği bütünsel stil.
          </p>
        </article>

        <article class="service reveal">
          <div class="service-number">05</div>
          <h3>Şekillendirme</h3>
          <p>
            Günlük ve özel günler için profesyonel şekillendirme.
          </p>
        </article>

        <article class="service reveal">
          <div class="service-number">06</div>
          <h3>Kişisel Stil</h3>
          <p>
            Tarzını yansıtan, sana özel görünüm üzerine danışmanlık.
          </p>
        </article>

      </div>

    </div>

  </section>

  <!-- ABOUT -->

  <section id="hakkimizda">

    <div class="container">

      <div class="about-grid">

        <div class="about-image reveal"></div>

        <div class="about-copy reveal">

          <div class="kicker">Tahir Dastan Hair Design</div>

          <h2>
            Stil,
            <br>
            detaylarda
            <em style="color:var(--gold-light);font-style:normal;">
              başlar.
            </em>
          </h2>

          <p>
            Saç tasarımı yalnızca bir kesim değildir.
            Yüz şekli, saç yapısı ve kişisel tarz birlikte
            değerlendirilerek ortaya daha dengeli bir görünüm çıkar.
          </p>

          <p>
            Tahir Dastan Hair Design'da amaç,
            ziyaretinden sonra aynaya baktığında
            tarzının gerçekten sana ait görünmesidir.
          </p>

          <div class="features">

            <div class="feature">
              <strong>Kişiye Özel Stil</strong>
              <span>Yüz ve saç yapısına uygun tasarım.</span>
            </div>

            <div class="feature">
              <strong>Modern Yaklaşım</strong>
              <span>Güncel saç trendleri ve teknikleri.</span>
            </div>

            <div class="feature">
              <strong>Özenli Uygulama</strong>
              <span>Detaylara odaklanan çalışma.</span>
            </div>

            <div class="feature">
              <strong>Kolay Randevu</strong>
              <span>WhatsApp üzerinden hızlı iletişim.</span>
            </div>

          </div>

        </div>

      </div>

    </div>

  </section>

  <!-- REVIEWS -->

  <section class="reviews" id="yorumlar">

    <div class="container">

      <div class="section-head reveal">

        <div class="kicker">Google Reviews</div>

        <h2>
          Müşteriler
          <br>Ne Diyor?
        </h2>

      </div>

      <div class="review-box reveal">

        <div>
          <div class="score">4.6</div>

          <div class="stars" style="font-size:18px;margin-top:8px;">
            ★★★★★
          </div>

          <div class="score-small">
            Google değerlendirme puanı
          </div>
        </div>

        <div class="review-copy">

          <h3>Gerçek deneyimler.</h3>

          <p>
            Tahir Dastan Hair Design hakkındaki güncel
            değerlendirmeleri Google üzerinden inceleyebilirsin.
          </p>

          <a class="btn btn-primary"
             href="https://maps.app.goo.gl/h6yJHbL4vkA2HwRU9"
             target="_blank">
            Google'da Yorumları Gör
          </a>

        </div>

      </div>

    </div>

  </section>

  <!-- APPOINTMENT -->

  <section class="appointment">

    <div class="container reveal">

      <div class="kicker">Randevu</div>

      <h2>
        Yeni tarzın için
        <br>
        randevunu oluştur.
      </h2>

      <p>
        Uygun gün ve saatleri öğrenmek için
        WhatsApp üzerinden bize ulaş.
